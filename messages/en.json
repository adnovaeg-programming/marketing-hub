  "legal": {
    "privacy": {
      "title": "Privacy Policy",
      "updatedAt": "Last updated: September 30, 2026",
      "s1": { "title": "1. Information We Collect", "body": "We collect information you provide directly — such as your name, email, organization name, and payment details. We also automatically collect technical data (device type, IP address, pages visited) to improve our service." },
      "s2": { "title": "2. How We Use Information", "body": "We use your data to:\n• Provide and improve the service.\n• Send important notifications.\n• Support you legally in disputes.\n• Analyze platform usage.\n\nWe never sell your data to third parties." },
      "s3": { "title": "3. Information Sharing", "body": "We only share your data:\n• With service providers (Supabase, Resend, Stripe).\n• Upon legal request from authorities.\n• To protect our rights in case of policy violations." },
      "s4": { "title": "4. Data Security", "body": "We use SSL encryption, Row-Level Security (RLS) on the database, and password hashing. Sensitive data is protected by RLS — meaning even our staff cannot access it without authorization." },
      "s5": { "title": "5. Cookies", "body": "We use essential session cookies and optional analytics cookies to improve your experience. You can refuse analytics cookies from the banner." },
      "s6": { "title": "6. Your Rights", "body": "You have the right to:\n• Export your data (GDPR).\n• Delete your account.\n• Modify your data.\n• Object to processing.\n\nContact us at privacy@onepost.io." },
      "s7": { "title": "7. Updates", "body": "We may update this policy from time to time. If there's a material change, we'll notify you by email." }
    },
    "terms": {
      "title": "Terms of Service",
      "updatedAt": "Last updated: September 30, 2026",
      "s1": { "title": "1. Acceptance of Terms", "body": "By using the One Post platform, you agree to these terms. If you don't agree, please don't use the platform." },
      "s2": { "title": "2. Your Account", "body": "You are responsible for:\n• The confidentiality of your password.\n• The accuracy of information provided.\n• All activities that occur from your account.\n\nWe are not responsible for any loss due to unauthorized use." },
      "s3": { "title": "3. Acceptable Use", "body": "Prohibited:\n• Using the platform for illegal activities.\n• Attempting to hack the system.\n• Publishing offensive or infringing content.\n• Sending spam.\n\nViolations result in immediate account termination." },
      "s4": { "title": "4. Intellectual Property", "body": "The platform, code, and design belong to us. Content you upload belongs to you, but you grant us a license to display and store it within the scope of providing the service." },
      "s5": { "title": "5. Payment & Refunds", "body": "Subscriptions renew automatically unless cancelled. Refunds are available within 14 days of payment if you haven't used the service." },
      "s6": { "title": "6. Disclaimer", "body": "We provide the service \"as is.\" We are not responsible for any indirect losses or data loss resulting from use." }
    },
    "cookies": {
      "title": "Cookie Policy",
      "updatedAt": "Last updated: September 30, 2026",
      "s1": { "title": "1. What Are Cookies?", "body": "Cookies are small files stored on your device when you visit the platform. They help us remember your preferences and improve the experience." },
      "s2": { "title": "2. Types of Cookies", "body": "• Essential: For session and security (required).\n• Analytics: To analyze usage (optional).\n• Preferences: For language and theme (Dark/Light)." },
      "s3": { "title": "3. Controlling Cookies", "body": "You can control cookies from your browser settings. However, some features may not work without essential cookies." },
      "s4": { "title": "4. Third-Party Cookies", "body": "We use Supabase (for Auth), Sentry (for error tracking), Resend (for emails). Each has its own independent privacy policy." }
    },
    "cookieBanner": {
