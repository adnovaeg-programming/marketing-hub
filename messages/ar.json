  "legal": {
    "privacy": {
      "title": "سياسة الخصوصية",
      "updatedAt": "آخر تحديث: 30 سبتمبر 2026",
      "s1": { "title": "1. المعلومات اللي بنجمعها", "body": "بنجمع المعلومات اللي بتقدمها لينا مباشرة — زي الاسم، الإيميل، اسم المؤسسة، ومعلومات الدفع. وكمان بنجمع بيانات تقنية تلقائيًا (نوع الجهاز، عنوان IP، الصفحات اللي زرتها) لتحسين خدمتنا." },
      "s2": { "title": "2. استخدام المعلومات", "body": "بنستخدم بياناتك عشان:\n• نقدم الخدمة ونحسّنها.\n• نرسل إشعارات مهمة.\n• ندعم قانونيًا في حالة النزاعات.\n• نحلّل استخدام المنصة.\n\nعمرنا ما نبيع بياناتك لأطراف تالتة." },
      "s3": { "title": "3. مشاركة المعلومات", "body": "بنشارك بياناتك فقط:\n• مع مزودي الخدمة (Supabase، Resend، Stripe).\n• عند طلب قانوني من جهة رسمية.\n• لحماية حقوقنا في حالة انتهاك الشروط." },
      "s4": { "title": "4. أمان البيانات", "body": "بنستخدم تشفير SSL، RLS على قاعدة البيانات، وتشفير كلمات المرور. البيانات حساسة بتخضع لـ Row-Level Security — يعني حتى موظفينا مش بيقدروا يشوفوها بدون إذن." },
      "s5": { "title": "5. الكوكيز", "body": "بنستخدم كوكيز أساسية للجلسة، وكوكيز تحليلية (اختيارية) لتحسين تجربتك. تقدر ترفض الكوكيز التحليلية من البانر." },
      "s6": { "title": "6. حقوقك", "body": "عندك حق:\n• تصدّر بياناتك (GDPR).\n• تحذف حسابك.\n• تعدّل بياناتك.\n• ترفض المعالجة.\n\nراسلنا على privacy@onepost.io." },
      "s7": { "title": "7. التحديثات", "body": "ممكن نحدّث السياسة دي من وقت للتاني. لو حصل تغيير جوهري، هنبلّغك بالإيميل." }
    },
    "terms": {
      "title": "الشروط والأحكام",
      "updatedAt": "آخر تحديث: 30 سبتمبر 2026",
      "s1": { "title": "1. قبول الشروط", "body": "باستخدامك لمنصة One Post، أنت موافق على الشروط دي. لو مش موافق، ما تستخدمش المنصة." },
      "s2": { "title": "2. حسابك", "body": "أنت مسؤول عن:\n• سرية كلمة المرور.\n• صحة البيانات المقدمة.\n• كل الأنشطة اللي بتحصل من حسابك.\n\nإحنا مش مسؤولين عن أي خسارة بسبب استخدام غير مصرح." },
      "s3": { "title": "3. الاستخدام المسموح", "body": "ممنوع:\n• استخدام المنصة في أنشطة غير قانونية.\n• محاولة اختراق النظام.\n• نشر محتوى مسيء أو مخالف.\n• إرسال Spam.\n\nالانتهاك بيؤدي لإغلاق حسابك فورًا." },
      "s4": { "title": "4. الملكية الفكرية", "body": "المنصة والكود والتصميم ملكنا. المحتوى اللي بترفعه ملكك، لكن بتمنحلنا ترخيص لعرضه وتخزينه في إطار تقديم الخدمة." },
      "s5": { "title": "5. الدفع والاسترداد", "body": "الاشتراكات تتجدد تلقائيًا إلا لو ألغيتها. الاسترداد متاح خلال 14 يوم من الدفع لو ما استخدمتش الخدمة." },
      "s6": { "title": "6. إخلاء المسؤولية", "body": "بنقدم الخدمة \"كما هي\". إحنا مش مسؤولين عن أي خسائر غير مباشرة أو فقدان بيانات ناتج عن الاستخدام." }
    },
    "cookies": {
      "title": "سياسة الكوكيز",
      "updatedAt": "آخر تحديث: 30 سبتمبر 2026",
      "s1": { "title": "1. إيه هي الكوكيز؟", "body": "الكوكيز هي ملفات صغيرة بتتخزن على جهازك لما تزور المنصة. بتساعدنا نفتكر تفضيلاتك ونحسّن التجربة." },
      "s2": { "title": "2. أنواع الكوكيز", "body": "• أساسية: للجلسة والأمان (إجبارية).\n• تحليلية: لتحليل الاستخدام (اختيارية).\n• تفضيلات: للغة والوضع (Dark/Light)." },
      "s3": { "title": "3. التحكم في الكوكيز", "body": "تقدر تتحكم في الكوكيز من إعدادات المتصفح. بس ممكن بعض الميزات ما تشتغلش بدون الكوكيز الأساسية." },
      "s4": { "title": "4. كوكيز الطرف الثالث", "body": "بنستخدم Supabase (للـ Auth)، Sentry (لتتبع الأخطاء)، Resend (للإيميلات). كل واحد عنده سياسة خصوصية مستقلة." }
    },
